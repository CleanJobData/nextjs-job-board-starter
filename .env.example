# CleanJobData API Configuration
# Get your API key from the dashboard: https://cleanjobdata.com/dashboard
CLEANJOBDATA_API_URL=https://api.cleanjobdata.com
CLEANJOBDATA_API_KEY=your_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_NAME="Clean Job Data"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (only required once a DB-backed feature is enabled in features.config.ts -
# auth, jobSync, resume, applications, or jobPosting). Matches .devcontainer/docker-compose.yml.
DATABASE_URL=postgres://cleanjobdata:cleanjobdata@localhost:5432/cleanjobdata

# Auth (only required when features.config.ts sets auth.enabled = true).
# Generate one with: npx auth secret
AUTH_SECRET=

# Email (only required when features.config.ts sets auth.emailVerification = true,
# or once other email-sending features - job alerts, digests - are built).
# Get an API key at https://resend.com, and a verified "from" address/domain.
RESEND_API_KEY=
EMAIL_FROM="CleanJobData <noreply@yourdomain.com>"

# OAuth (only required for providers listed in features.config.ts's auth.oauthProviders)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_LINKEDIN_ID=
# AUTH_LINKEDIN_SECRET=

# Scheduled tasks (only required if any enabled feature registers a cron task -
# today that's job-sync when jobSync.enabled = true). Whatever scheduler
# triggers POST /api/cron must send this as `Authorization: Bearer <value>` -
# see docs/CRON.md.
CRON_SECRET=
